<template>
  <!-- Круглый экран 480×480. Ширина полезной полосы зависит от высоты:
       на y=46 круг даёт 282px, на y=114 уже 408, в середине все 480, на
       y=434 снова 282. Поэтому экран разложен трапецией: узкие ряды сверху
       и снизу, широкие — в середине. Каждый блок занимает всю доступную
       на своей высоте ширину: пустого места на часах быть не должно.
       Мелких подписей-ссылок больше нет — по ним не попасть пальцем. -->
  <div class="page">
    <!-- Переходы наверху: нужны редко, поэтому стоят в узкой верхней
         полосе, но остаются кнопками, а не текстом. -->
    <div class="nav-row">
      <div class="nav-button" onclick="openNotes"><text class="nav-label">Заметки</text></div>
      <div class="nav-button" onclick="openSettings"><text class="nav-label">Настройки</text></div>
    </div>

    <!-- Область ответа — тоже цель для пальца: когда ответа ещё нет, тап по
         ней начинает разговор. На часах промахнуться мимо кнопки легко, а
         промахнуться мимо трети экрана — нет.
         Верхняя строка совмещает состояние и распознанный текст: отдельная
         строка «услышал» не помещалась, не срезав ответ. -->
    <div class="answer-area" onclick="tapAnswer">
      <text class="status">{{status}}</text>
      <text class="answer">{{result}}</text>
      <text class="read-more" if="{{hasAnswer}}" onclick="openAnswer">читать полностью →</text>
      <text class="error" if="{{errorText}}">{{errorText}}</text>
    </div>

    <!-- Главное действие занимает всю ширину, какую круг даёт на этой
         высоте. -->
    <div class="{{talkClass}}" onclick="talk">
      <text class="talk-label">{{talkLabel}}</text>
    </div>

    <!-- Нижний ряд меняет содержимое, но не высоту: иначе при отмене или
         откате вся колонка съезжала бы под рамку. -->
    <div class="quick-row" if="{{showQuick}}">
      <div class="quick-button home-button" onclick="startHome"><text class="quick-label">{{homeLabel}}</text></div>
      <div class="quick-button note-button" onclick="startNote"><text class="quick-label">Заметка</text></div>
    </div>
    <div class="quick-row" if="{{undoToken}}">
      <div class="wide-button undo-button" onclick="undoLast"><text class="quick-label">Отменить действие</text></div>
    </div>
    <div class="quick-row" if="{{showCancel}}">
      <div class="wide-button cancel-button" onclick="unstick"><text class="quick-label">Отменить</text></div>
    </div>
  </div>
</template>

<script>
import prompt from "@system.prompt"
import vibrator from "@system.vibrator"
import router from "@system.router"
import { query, voiceUri, voiceBytes, status as fetchStatus, confirmHome, undoHome } from "../../common/api"
import { recordAudio, stopRecording, cancelRecording } from "../../common/audio"
import { loadSettings, getCached, getRecordingSettings, applyRemoteRuntime } from "../../common/settings"
import { speak } from "../../common/speech"
import { isOnline } from "../../common/net"
import { loadQueue, getQueued, flush } from "../../common/queue"
import { loadCachedNotes } from "../../common/notes-cache"

function messageFrom(error) {
  return error && error.message ? error.message : "Не удалось связаться со шлюзом"
}

export default {
  private: {
    status: "готов",
    result: "Нажмите и спросите",
    errorText: "",
    busy: false,
    talkClass: "talk-button",
    talkLabel: "Говорить",
    hasAnswer: false,
    answerSource: "",
    speechId: "",
    voiceEpoch: 0,
    recording: false,
    tickerId: 0,
    settingsReady: false,
    lastSyncAt: 0,
    undoToken: "",
    undoTimer: 0,
    showQuick: true,
    showCancel: false,
    homeAvailable: false,
    homeLabel: "Дом · ?"
  },

  onShow() {
    var self = this
    loadSettings(function() {
      self.settingsReady = true
      if (!getCached().gatewayUrl || !getCached().deviceToken) {
        self.errorText = "Шлюз не настроен"
        return
      }
      // onShow срабатывает заново каждый раз, когда экран гаснет и зажигается
      // — документация Vela отдельно предупреждает не вешать на него запрос
      // без оглядки. На часах экран гаснет постоянно, поэтому синхронизация
      // идёт по тому же 30-секундному окну, что и остальное.
      var now = Date.now()
      if (self.lastSyncAt && now - self.lastSyncAt < 30000) return
      self.lastSyncAt = now
      // Runtime tuning is protected by the same device token and cached for
      // offline use. A failed refresh is intentionally silent: the last
      // known-good values and conservative local defaults remain usable.
      fetchStatus(function(response) {
        if (response && response.runtime) applyRemoteRuntime(response.runtime)
        if (response && response.capabilities) {
          self.homeAvailable = response.capabilities.home === true
          self.homeLabel = self.homeAvailable ? "Дом" : "Дом · нет"
        }
      }, function() {})
      // Кэш заметок нужен экрану заметок, но читаем его здесь: приложение
      // открывается с этого экрана, и к переходу список уже готов.
      loadCachedNotes(function() {
        loadQueue(function() { self.flushQueue() })
      })
    })
  },

  // Документация по памяти требует гасить незавершённые таймеры при разрушении
  // страницы. Счётчик — это setInterval: без этого он продолжал бы тикать
  // после ухода со страницы, удерживая замыкание на всю вьюмодель.
  onDestroy() {
    this.stopTicker()
    if (this.undoTimer) {
      clearTimeout(this.undoTimer)
      this.undoTimer = 0
    }
  },

  // Досылка отложенных заметок идёт молча и не поднимает флаг занятости:
  // человек пришёл разговаривать, а не ждать синхронизацию.
  flushQueue() {
    isOnline(function(online) {
      if (!online || getQueued().length === 0) return
      flush(function(item, onOk, onErr, onDrop) {
        if (item.kind === "audio") {
          voiceUri(item.uri, item.contentType, "note", function() { onOk() }, function(error) {
            if (error && error.gone) onDrop()
            else onErr()
          }, { preview: false, requestKey: item.requestId })
          return
        }
        query("Запиши: " + item.text, function() { onOk() }, function() { onErr() }, item.requestId)
      }, function() {})
    })
  },

  setBusy(value) {
    this.busy = value
    this.talkClass = value ? "talk-busy" : "talk-button"
    this.showCancel = value
    this.showQuick = !value && !this.undoToken
  },

  // Системному диалогу таймаут не поставишь — человек думает сколько угодно.
  // Поэтому «Отменить» всегда возвращает приложение в рабочее состояние.
  unstick() {
    if (!this.busy) return
    this.voiceEpoch += 1
    this.stopTicker()
    if (this.recording) cancelRecording()
    this.recording = false
    this.setBusy(false)
    this.status = "готов"
    this.updateTalkLabel()
    this.errorText = "Отменено"
  },

  updateTalkLabel() {
    this.talkLabel = this.hasAnswer ? "Ещё вопрос" : "Говорить"
  },

  openSettings() {
    router.push({ uri: "/pages/settings" })
  },

  openNotes() {
    router.push({ uri: "/pages/notes" })
  },

  // Пока ответа нет, тап по центру экрана означает «хочу спросить».
  // Когда ответ есть — открывает его целиком: длинный текст на круглом
  // экране обрезается, и прочитать остальное иначе негде.
  tapAnswer() {
    if (this.busy || this.recording) {
      this.talk()
      return
    }
    if (!this.hasAnswer) {
      this.startVoice("")
      return
    }
    this.openAnswer()
  },

  openAnswer() {
    if (!this.hasAnswer) return
    router.push({
      uri: "/pages/answer",
      params: { text: this.result, source: this.answerSource, speechId: this.speechId }
    })
  },

  // Первое нажатие начинает запись, второе — заканчивает её.
  //
  // Раньше запись всегда длилась фиксированные десять секунд: часы не знают,
  // что человек договорил, и он стоял перед экраном, ожидая непонятно чего.
  // Повторное нажатие тогда отменяло всё целиком — худшее из поведений.
  talk() {
    if (!this.settingsReady || !getCached().gatewayUrl || !getCached().deviceToken) {
      this.errorText = "Сначала настройте шлюз"
      return
    }
    if (this.recording) {
      this.finishRecording()
      return
    }
    if (this.busy) {
      this.unstick()
      return
    }
    this.startVoice("")
  },

  finishRecording() {
    this.recording = false
    this.beginThinking()
    // record.stop() завершает запись, и рантайм отдаёт файл в тот же
    // success-колбэк, что и по истечении времени.
    stopRecording()
  },

  // Видимое ожидание переносится легче молчаливого. Через телефон ответ идёт
  // секунды, и без бегущего счётчика экран выглядит зависшим — человек жмёт
  // ещё раз и всё отменяет.
  startTicker(mode) {
    var self = this
    self.stopTicker()
    var started = Date.now()
    self.tickerId = setInterval(function() {
      var passed = Math.round((Date.now() - started) / 1000)
      if (mode === "record") {
        var left = Math.max(0, Math.round(getRecordingSettings().maxRecordingMs / 1000) - passed)
        self.status = left > 0 ? "говорите · " + left : "заканчиваю…"
      } else {
        self.status = "думаю · " + passed
      }
    }, 1000)
  },

  stopTicker() {
    if (this.tickerId) {
      clearInterval(this.tickerId)
      this.tickerId = 0
    }
  },

  beginThinking() {
    this.talkLabel = "Думаю"
    this.status = "думаю · 0"
    this.startTicker("think")
  },

  startVoice(intent) {
    var self = this
    if (self.busy) return
    var epoch = self.voiceEpoch + 1
    self.voiceEpoch = epoch
    self.recording = true
    self.setBusy(true)
    self.errorText = ""
    self.talkLabel = "Готово"
    self.result = getRecordingSettings().autoStop ? "Говорите — закончу сам" : "Нажмите, когда договорите"
    self.status = "говорите · " + Math.round(getRecordingSettings().maxRecordingMs / 1000)
    self.startTicker("record")

    recordAudio(function(audio) {
      if (epoch !== self.voiceEpoch) return
      self.recording = false
      self.beginThinking()

      var send = audio.bytes ? voiceBytes : voiceUri
      var source = audio.bytes || audio.uri
      send(source, audio.contentType, intent, function(response) {
        if (epoch !== self.voiceEpoch) return
        self.stopTicker()
        self.setBusy(false)
        self.errorText = ""

        if (response.kind === "home" && response.requiresConfirmation && response.confirmationToken) {
          self.applyResponse(response)
          self.askHomeConfirmation(response)
          return
        }
        self.applyResponse(response)
      }, function(error) {
        if (epoch !== self.voiceEpoch) return
        self.stopTicker()
        self.setBusy(false)
        self.status = "ошибка"
        self.errorText = messageFrom(error)
        self.updateTalkLabel()
      }, { recordedMs: audio.recordedMs })
    }, function(error) {
      if (epoch !== self.voiceEpoch) return
      self.recording = false
      self.stopTicker()
      self.setBusy(false)
      self.status = "готов"
      self.errorText = messageFrom(error)
      self.updateTalkLabel()
    })
  },

  startHome() {
    if (this.busy) return
    if (!this.homeAvailable) {
      this.errorText = "Дом не настроен на шлюзе"
      return
    }
    this.startVoice("home")
  },

  // «Дом» начинает запись сразу, и «Заметка» рядом обязана вести себя так же.
  // Прежде она открывала список и молча ждала второго нажатия — выглядело
  // это как «заметку передать не получается».
  startNote() {
    if (this.busy) return
    router.push({ uri: "/pages/notes", params: { autoDictate: "1" } })
  },

  applyResponse(response) {
    // Распознанный текст занимает строку состояния: отдельной строки под
    // него на круглом экране нет, а знать, что именно услышали часы, нужно.
    this.status = response.transcript ? "услышал: " + response.transcript : "готов"
    this.result = response.text || "Готово"
    this.errorText = ""
    this.hasAnswer = !!response.text
    this.answerSource = response.source || response.kind || ""
    this.speechId = response.speechId || ""
    this.setUndo(response.undoToken || "")
    this.updateTalkLabel()
    vibrator.vibrate({ mode: "short" })
    if (this.speechId && getCached().speakAnswers) {
      var self = this
      speak(this.speechId, function() {}, function(error) { self.errorText = messageFrom(error) })
    }
  },

  setUndo(token) {
    if (this.undoTimer) clearTimeout(this.undoTimer)
    this.undoToken = token || ""
    this.showQuick = !this.busy && !this.undoToken
    if (!this.undoToken) return
    var self = this
    this.undoTimer = setTimeout(function() {
      self.undoToken = ""
      self.undoTimer = 0
      self.showQuick = !self.busy
    }, 30000)
  },

  undoLast() {
    var self = this
    var token = self.undoToken
    if (!token || self.busy) return
    self.setUndo("")
    self.setBusy(true)
    self.status = "возвращаю…"
    undoHome(token, function(response) {
      self.setBusy(false)
      self.applyResponse(response)
    }, function(error) {
      self.setBusy(false)
      self.status = "готов"
      self.errorText = messageFrom(error)
    })
  },

  // Этот диалог остаётся только для будущих небезопасных действий. Свет с
  // точной комнатой сервер выполняет сразу и возвращает квитанцию + отмену.
  askHomeConfirmation(response) {
    var self = this
    prompt.showDialog({
      title: "Выполнить команду?",
      message: response.command ? (response.command.action === "on" ? "Включить" : "Выключить") + " свет" : response.text,
      buttons: [{ text: "Выполнить" }, { text: "Отмена" }],
      success: function(data) {
        if (data && data.index === 0) {
          self.status = "выполняю…"
          confirmHome(response.confirmationToken, function(result) {
            self.applyResponse(result)
          }, function(error) {
            self.status = "ошибка"
            self.errorText = messageFrom(error)
          })
        } else {
          self.status = "готов"
          self.result = "Команда отменена"
        }
      }
    })
  }
}
</script>

<style>
/* Страница всегда во весь экран: при меньшей ширине рантайм прижимает
   содержимое влево, и на круглом экране левый край уходит под рамку.
   flex-direction задаём явно: div в Vela по умолчанию раскладывает детей
   в строку. */
.page {
  width: 480px; height: 480px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #0b1020;
}

/* Верхняя полоса: на этой высоте круг даёт 282px. */
.nav-row { flex-direction: row; justify-content: center; align-items: center; height: 68px; }
.nav-button { width: 134px; height: 68px; border-radius: 20px; background-color: #22314e; justify-content: center; align-items: center; margin-left: 4px; margin-right: 4px; }
.nav-label { color: #cfe0f7; font-size: 17px; font-weight: bold; text-align: center; }

/* Середина экрана — самая широкая часть круга, здесь 400px проходят. */
.answer-area { flex-direction: column; align-items: center; justify-content: center; width: 400px; height: 122px; margin-top: 4px; }
.status { color: #7de3ff; font-size: 17px; height: 22px; width: 340px; lines: 1; text-overflow: ellipsis; text-align: center; }
.answer { color: #ffffff; font-size: 27px; lines: 2; text-overflow: ellipsis; text-align: center; width: 400px; }
.read-more { color: #70d7ef; font-size: 17px; height: 24px; text-align: center; }
.error { color: #ff8f8f; font-size: 16px; height: 24px; lines: 1; text-align: center; width: 380px; text-overflow: ellipsis; }

/* Заливка только сплошным цветом. linear-gradient рантайм не рисует вовсе:
   кнопка оставалась прозрачной, а тёмная подпись на тёмном фоне исчезала.
   box-shadow на устройстве превращался в широкое кольцо вокруг невидимой
   кнопки — то самое «кольцо, съедающее центр» с фотографии.
   Составные селекторы в этой сборке Vela не работают, поэтому у занятого
   состояния отдельный самостоятельный класс, а класс биндится целиком. */
.talk-button {
  width: 400px; height: 116px; border-radius: 40px;
  background-color: #31b2d8;
  justify-content: center; align-items: center;
  margin-top: 4px;
}
.talk-busy {
  width: 400px; height: 116px; border-radius: 40px;
  background-color: #6f8aa6;
  justify-content: center; align-items: center;
  margin-top: 4px;
}
.talk-label { color: #07111e; font-size: 30px; font-weight: bold; text-align: center; }

/* Нижняя полоса: круг здесь снова 282px, поэтому ряд не шире 276. */
.quick-row { flex-direction: row; justify-content: center; align-items: center; height: 74px; margin-top: 4px; }
.quick-button { width: 134px; height: 74px; border-radius: 22px; justify-content: center; align-items: center; margin-left: 4px; margin-right: 4px; }
.wide-button { width: 276px; height: 74px; border-radius: 22px; justify-content: center; align-items: center; }
.home-button { background-color: #d59b58; }
.note-button { background-color: #7fa6cc; }
.undo-button { background-color: #d98a91; }
/* Светлая заливка и у отмены: подпись во всех кнопках этого ряда тёмная,
   а на тёмном фоне она просто исчезает — этим уже один раз пропала
   главная кнопка. */
.cancel-button { background-color: #9fb3cc; }
.quick-label { color: #07111e; font-size: 18px; font-weight: bold; text-align: center; }
</style>
