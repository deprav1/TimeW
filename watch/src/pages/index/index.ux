<template>
  <!-- Круглый экран 480×480. Ширина полезной области зависит от высоты:
       у самого верха и низа круг сужается примерно до 250px, в середине
       даёт все 480. Поэтому всё выравнено по центру, боковые отступы
       крупные, а главная кнопка стоит там, где круг широкий.
       Проверено фотографией с устройства: текст, начинавшийся у левого
       края, срезало — «Личный помощник» превращался в «ичный помощник». -->
  <div class="page">
    <text class="status">{{status}}</text>

    <!-- Область ответа — тоже цель для пальца: когда ответа ещё нет, тап по
         ней начинает разговор. На часах промахнуться мимо кнопки легко, а
         промахнуться мимо половины экрана — нет. -->
    <div class="answer-area" onclick="tapAnswer">
      <text class="heard" if="{{transcript}}">{{transcript}}</text>
      <text class="answer">{{result}}</text>
      <text class="read-more" if="{{hasAnswer}}" onclick="openAnswer">читать полностью →</text>
    </div>

    <!-- Одна большая круглая цель: на часах палец закрывает пол-экрана,
         и мелкие кнопки просто не нажимаются. -->
    <div class="{{talkClass}}" onclick="talk">
      <text class="talk-label">{{talkLabel}}</text>
    </div>

    <div class="quick-row" if="{{showQuick}}">
      <div class="quick-button home-button" onclick="startHome"><text class="quick-label">{{homeLabel}}</text></div>
      <div class="quick-button note-button" onclick="startNote"><text class="quick-label">Заметка</text></div>
    </div>
    <div class="quick-row" if="{{undoToken}}">
      <div class="quick-button undo-button" onclick="undoLast"><text class="quick-label">Отменить действие</text></div>
    </div>

    <div class="cancel-button" if="{{showCancel}}" onclick="unstick"><text class="cancel-label">Отменить</text></div>

    <text class="error" if="{{errorText}}">{{errorText}}</text>

    <div class="bottom-row">
      <text class="link" onclick="openNotes">заметки</text>
      <text class="link" if="{{hasAnswer}}" onclick="resetDialogue">заново</text>
      <text class="link" onclick="openSettings">настр.</text>
    </div>
  </div>
</template>

<script>
import prompt from "@system.prompt"
import vibrator from "@system.vibrator"
import router from "@system.router"
import { query, voiceUri, voiceBytes, status as fetchStatus, resetDialog, confirmHome, undoHome } from "../../common/api"
import { recordAudio, stopRecording, cancelRecording } from "../../common/audio"
import { loadSettings, getCached, getRecordingSettings, applyRemoteRuntime } from "../../common/settings"
import { speak } from "../../common/speech"
import { isOnline } from "../../common/net"
import { loadQueue, getQueued, flush } from "../../common/queue"
import { loadCachedNotes } from "../../common/notes-cache"

function messageFrom(error) {
  return error && error.message ? error.message : "Не удалось связаться со шлюзом"
}

export default {
  private: {
    status: "готов",
    result: "Нажмите и спросите",
    transcript: "",
    errorText: "",
    busy: false,
    talkClass: "talk-button",
    talkLabel: "Говорить",
    hasAnswer: false,
    answerSource: "",
    speechId: "",
    voiceEpoch: 0,
    recording: false,
    tickerId: 0,
    settingsReady: false,
    lastSyncAt: 0,
    undoToken: "",
    undoTimer: 0,
    showQuick: true,
    showCancel: false,
    homeAvailable: false,
    homeLabel: "Дом · ?"
  },

  onShow() {
    var self = this
    loadSettings(function() {
      self.settingsReady = true
      if (!getCached().gatewayUrl || !getCached().deviceToken) {
        self.errorText = "Шлюз не настроен"
        return
      }
      // Runtime tuning is protected by the same device token and cached for
      // offline use. A failed refresh is intentionally silent: the last
      // known-good values and conservative local defaults remain usable.
      fetchStatus(function(response) {
        if (response && response.runtime) applyRemoteRuntime(response.runtime)
        if (response && response.capabilities) {
          self.homeAvailable = response.capabilities.home === true
          self.homeLabel = self.homeAvailable ? "Дом" : "Дом · нет"
        }
      }, function() {})
      var now = Date.now()
      if (self.lastSyncAt && now - self.lastSyncAt < 30000) return
      self.lastSyncAt = now
      // Кэш заметок нужен экрану заметок, но читаем его здесь: приложение
      // открывается с этого экрана, и к переходу список уже готов.
      loadCachedNotes(function() {
        loadQueue(function() { self.flushQueue() })
      })
    })
  },

  // Досылка отложенных заметок идёт молча и не поднимает флаг занятости:
  // человек пришёл разговаривать, а не ждать синхронизацию.
  flushQueue() {
    isOnline(function(online) {
      if (!online || getQueued().length === 0) return
      flush(function(item, onOk, onErr, onDrop) {
        if (item.kind === "audio") {
          voiceUri(item.uri, item.contentType, "note", function() { onOk() }, function(error) {
            if (error && error.gone) onDrop()
            else onErr()
          }, { preview: false, requestKey: item.requestId })
          return
        }
        query("Запиши: " + item.text, function() { onOk() }, function() { onErr() }, item.requestId)
      }, function() {})
    })
  },

  setBusy(value) {
    this.busy = value
    this.talkClass = value ? "talk-busy" : "talk-button"
    this.showCancel = value
    this.showQuick = !value && !this.undoToken
  },

  // Системному диалогу таймаут не поставишь — человек думает сколько угодно.
  // Поэтому тап по статусу всегда возвращает приложение в рабочее состояние.
  unstick() {
    if (!this.busy) return
    this.voiceEpoch += 1
    this.stopTicker()
    if (this.recording) cancelRecording()
    this.recording = false
    this.setBusy(false)
    this.status = "готов"
    this.updateTalkLabel()
    this.errorText = "Отменено"
  },

  updateTalkLabel() {
    this.talkLabel = this.hasAnswer ? "Ещё вопрос" : "Говорить"
  },

  openSettings() {
    router.push({ uri: "/pages/settings" })
  },

  openNotes() {
    router.push({ uri: "/pages/notes" })
  },

  // Пока ответа нет, тап по центру экрана означает «хочу спросить».
  // Когда ответ есть — открывает его целиком: короткий текст на круглом
  // экране обрезается, и прочитать остальное иначе негде.
  tapAnswer() {
    if (this.busy || this.recording) {
      this.talk()
      return
    }
    if (!this.hasAnswer) {
      this.startVoice("")
      return
    }
    this.openAnswer()
  },

  openAnswer() {
    if (!this.hasAnswer) return
    router.push({
      uri: "/pages/answer",
      params: { text: this.result, source: this.answerSource, speechId: this.speechId }
    })
  },

  // Первое нажатие начинает запись, второе — заканчивает её.
  //
  // Раньше запись всегда длилась фиксированные десять секунд: часы не знают,
  // что человек договорил, и он стоял перед экраном, ожидая непонятно чего.
  // Повторное нажатие тогда отменяло всё целиком — худшее из поведений.
  talk() {
    if (!this.settingsReady || !getCached().gatewayUrl || !getCached().deviceToken) {
      this.errorText = "Сначала настройте шлюз"
      return
    }
    if (this.recording) {
      this.finishRecording()
      return
    }
    if (this.busy) {
      this.unstick()
      return
    }
    this.startVoice("")
  },

  finishRecording() {
    this.recording = false
    this.beginThinking()
    // record.stop() завершает запись, и рантайм отдаёт файл в тот же
    // success-колбэк, что и по истечении времени.
    stopRecording()
  },

  // Видимое ожидание переносится легче молчаливого. Через телефон ответ идёт
  // секунды, и без бегущего счётчика экран выглядит зависшим — человек жмёт
  // ещё раз и всё отменяет.
  startTicker(mode) {
    var self = this
    self.stopTicker()
    var started = Date.now()
    self.tickerId = setInterval(function() {
      var passed = Math.round((Date.now() - started) / 1000)
      if (mode === "record") {
        var left = Math.max(0, Math.round(getRecordingSettings().maxRecordingMs / 1000) - passed)
        self.status = left > 0 ? "говорите · " + left : "заканчиваю…"
      } else {
        self.status = "думаю · " + passed
      }
    }, 1000)
  },

  stopTicker() {
    if (this.tickerId) {
      clearInterval(this.tickerId)
      this.tickerId = 0
    }
  },

  beginThinking() {
    this.talkLabel = "Думаю"
    this.status = "думаю · 0"
    this.startTicker("think")
  },

  startVoice(intent) {
    var self = this
    if (self.busy) return
    var epoch = self.voiceEpoch + 1
    self.voiceEpoch = epoch
    self.recording = true
    self.setBusy(true)
    self.errorText = ""
    self.transcript = ""
    self.talkLabel = "Готово"
    self.result = getRecordingSettings().autoStop ? "Говорите — закончу сам" : "Нажмите, когда договорите"
    self.status = "говорите · " + Math.round(getRecordingSettings().maxRecordingMs / 1000)
    self.startTicker("record")

    recordAudio(function(audio) {
      if (epoch !== self.voiceEpoch) return
      self.recording = false
      self.beginThinking()

      var send = audio.bytes ? voiceBytes : voiceUri
      var source = audio.bytes || audio.uri
      send(source, audio.contentType, intent, function(response) {
        if (epoch !== self.voiceEpoch) return
        self.stopTicker()
        self.setBusy(false)
        self.errorText = ""
        self.transcript = response.transcript || ""

        if (response.kind === "home" && response.requiresConfirmation && response.confirmationToken) {
          self.applyResponse(response)
          self.askHomeConfirmation(response)
          return
        }
        self.applyResponse(response)
      }, function(error) {
        if (epoch !== self.voiceEpoch) return
        self.stopTicker()
        self.setBusy(false)
        self.status = "ошибка"
        self.errorText = messageFrom(error)
        self.updateTalkLabel()
      }, { recordedMs: audio.recordedMs })
    }, function(error) {
      if (epoch !== self.voiceEpoch) return
      self.recording = false
      self.stopTicker()
      self.setBusy(false)
      self.status = "готов"
      self.errorText = messageFrom(error)
      self.updateTalkLabel()
    })
  },

  startHome() {
    if (this.busy) return
    if (!this.homeAvailable) {
      this.errorText = "Дом не настроен на шлюзе"
      return
    }
    this.startVoice("home")
  },

  startNote() {
    if (this.busy) return
    router.push({ uri: "/pages/notes" })
  },

  applyResponse(response) {
    this.status = "готов"
    this.result = response.text || "Готово"
    this.errorText = ""
    this.hasAnswer = !!response.text
    this.answerSource = response.source || response.kind || ""
    this.speechId = response.speechId || ""
    this.setUndo(response.undoToken || "")
    this.updateTalkLabel()
    vibrator.vibrate({ mode: "short" })
    if (this.speechId && getCached().speakAnswers) {
      var self = this
      speak(this.speechId, function() {}, function(error) { self.errorText = messageFrom(error) })
    }
  },

  setUndo(token) {
    if (this.undoTimer) clearTimeout(this.undoTimer)
    this.undoToken = token || ""
    this.showQuick = !this.busy && !this.undoToken
    if (!this.undoToken) return
    var self = this
    this.undoTimer = setTimeout(function() {
      self.undoToken = ""
      self.undoTimer = 0
      self.showQuick = !self.busy
    }, 30000)
  },

  undoLast() {
    var self = this
    var token = self.undoToken
    if (!token || self.busy) return
    self.setUndo("")
    self.setBusy(true)
    self.status = "возвращаю…"
    undoHome(token, function(response) {
      self.setBusy(false)
      self.applyResponse(response)
    }, function(error) {
      self.setBusy(false)
      self.status = "готов"
      self.errorText = messageFrom(error)
    })
  },

  // Этот диалог остаётся только для будущих небезопасных действий. Свет с
  // точной комнатой сервер выполняет сразу и возвращает квитанцию + отмену.
  askHomeConfirmation(response) {
    var self = this
    prompt.showDialog({
      title: "Выполнить команду?",
      message: response.command ? (response.command.action === "on" ? "Включить" : "Выключить") + " свет" : response.text,
      buttons: [{ text: "Выполнить" }, { text: "Отмена" }],
      success: function(data) {
        if (data && data.index === 0) {
          self.status = "выполняю…"
          confirmHome(response.confirmationToken, function(result) {
            self.applyResponse(result)
          }, function(error) {
            self.status = "ошибка"
            self.errorText = messageFrom(error)
          })
        } else {
          self.status = "готов"
          self.result = "Команда отменена"
        }
      }
    })
  },

  resetDialogue() {
    var self = this
    if (self.busy) return
    prompt.showDialog({
      title: "Начать заново?",
      message: "История разговора будет очищена",
      buttons: [{ text: "Очистить" }, { text: "Отмена" }],
      success: function(data) {
        if (!data || data.index !== 0) return
        self.setBusy(true)
        resetDialog(function() {
          self.stopTicker()
          self.setBusy(false)
          self.status = "готов"
          self.transcript = ""
          self.result = "Нажмите и спросите"
          self.hasAnswer = false
          self.errorText = ""
          self.updateTalkLabel()
        }, function(error) {
          self.stopTicker()
          self.setBusy(false)
          self.status = "ошибка"
          self.errorText = messageFrom(error)
        })
      }
    })
  }
}
</script>

<style>
/* flex-direction задаём явно: div в Vela по умолчанию раскладывает детей
   в строку, и без этого заголовок с текстом встают рядом. */
.page {
  flex-direction: column;
  align-items: center;
  background-color: #0b1020;
  padding-left: 40px;
  padding-right: 40px;
  padding-top: 20px;
  padding-bottom: 14px;
}

/* Статус — он же аварийный размыкатель: тап снимает залипшее состояние. */
.status { color: #7de3ff; font-size: 17px; height: 20px; text-align: center; }

.answer-area { flex-direction: column; align-items: center; width: 100%; height: 118px; margin-top: 4px; }
.heard { color: #6f9fc2; font-size: 15px; lines: 1; text-overflow: ellipsis; text-align: center; width: 100%; }
.answer { color: #ffffff; font-size: 23px; lines: 3; text-overflow: ellipsis; text-align: center; width: 100%; margin-top: 4px; }
.read-more { color: #70d7ef; font-size: 14px; margin-top: 4px; }

/* 200×200 — палец попадает не глядя. Составные селекторы в этой сборке Vela
   не работают, поэтому у занятого состояния отдельный самостоятельный класс,
   а класс биндится целиком. */
.talk-button {
  width: 176px; height: 176px; border-radius: 88px;
  background-color: #2b9ec2;
  justify-content: center; align-items: center;
  margin-top: 5px;
}
.talk-busy {
  width: 176px; height: 176px; border-radius: 88px;
  background-color: #1b5f75;
  justify-content: center; align-items: center;
  margin-top: 5px;
}
.talk-label { color: #07111e; font-size: 25px; font-weight: bold; text-align: center; }

.quick-row { flex-direction: row; justify-content: center; align-items: center; height: 48px; margin-top: 7px; }
.quick-button { width: 118px; height: 44px; border-radius: 15px; justify-content: center; align-items: center; margin-left: 5px; margin-right: 5px; }
.home-button { background-color: #d59b58; }
.note-button { background-color: #355273; }
.undo-button { width: 246px; background-color: #b85e66; }
.quick-label { color: #07111e; font-size: 17px; font-weight: bold; text-align: center; }
.cancel-button { width: 180px; height: 40px; border-radius: 14px; background-color: #24344f; justify-content: center; align-items: center; margin-top: 7px; }
.cancel-label { color: #d9e6ff; font-size: 16px; }

.error { color: #ff8f8f; font-size: 14px; margin-top: 5px; lines: 1; text-align: center; width: 100%; text-overflow: ellipsis; }

/* Нижний ряд стоит там, где круг уже сузился примерно до 265px, поэтому
   подписи короткие и с запасом по краям. */
.bottom-row { flex-direction: row; justify-content: center; align-items: center; margin-top: 8px; height: 26px; }
.link { color: #70d7ef; font-size: 17px; padding-left: 10px; padding-right: 10px; }
</style>
