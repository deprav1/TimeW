<template>
  <div class="page">
    <!-- Верхняя полоса круга даёт 265px — ровно две кнопки по 126.
         Заголовка нет: экран открывается строкой «Диагностика», и так
         понятно, где мы. -->
    <div class="top-row">
      <div class="top-button" onclick="goBack"><text class="top-label">Назад</text></div>
      <div class="top-button send-button" onclick="send"><text class="top-label">Отчёт</text></div>
    </div>

    <!-- Большая самостоятельная цель во всю ширину. Она же останавливает
         проверку: отдельная кнопка «Остановить» отнимала ряд, а в ряду на
         этой высоте помещается только она сама. -->
    <div class="run-button" onclick="run">
      <text class="run-label">{{runLabel}}</text>
    </div>

    <text class="progress" if="{{progressText}}">{{progressText}}</text>

    <!-- Ни list, ни list-item: в этой сборке Vela они не рисуются — ни сами
         по себе, ни внутри scroll (проверено в эмуляторе на экране ответа).
         Работает scroll с обычными div, в том числе с for. -->
    <scroll class="diag-scroll" scroll-y="true">
      <div class="line" for="{{lines}}">
        <text class="line-text">{{ $item.text }}</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import fetch from "@system.fetch"
import record from "@system.record"
import request from "@system.request"
import uploadtask from "@system.uploadtask"
import prompt from "@system.prompt"
import audio from "@system.audio"
import file from "@system.file"
import volume from "@system.volume"
import { loadSettings, getCached } from "../../common/settings"
import { networkType } from "../../common/net"
import { sendDiagnostics, lastVoiceStats } from "../../common/api"
import { recordAudio, recordingCapability, probeFrames, probeRecordShapes } from "../../common/audio"
import { lastPlaybackReport, lastSpeechReport, speakTest } from "../../common/speech"
import { CONFIG_STAMP } from "../../common/config"
import { VERSION_CODE } from "../../common/build-info"

// Опрос рантайма: какие методы на самом деле есть на этой прошивке.
// Именно так когда-то выяснилось, что prompt.show и request.upload
// отсутствуют, — документация об этом умалчивает, а вызов несуществующего
// метода не возвращает ошибку, а бросает исключение.
function probe(name, module, methods) {
  var present = []
  var missing = []
  methods.forEach(function(method) {
    var exists = false
    try { exists = module && typeof module[method] === "function" } catch (error) { exists = false }
    if (exists) present.push(method)
    else missing.push(method)
  })
  return { module: name, present: present, missing: missing }
}

export default {
  private: {
    lines: [],
    runClass: "run-button",
    runLabel: "Проверить всё",
    busy: false,
    hasReport: false,
    sentText: "",
    progressText: "",
    report: null,
    tlsResults: [],
    cancelled: false,
    showCancel: false
  },

  goBack() {
    router.back()
  },

  add(text, value) {
    // Копия массива, а не push: в этой сборке Vela изменение на месте
    // не всегда перерисовывает список.
    //
    // На экране живут только последние шесть строк: scroll в этой сборке не
    // обрезает содержимое, и полный отчёт уезжал под рамку. Хвост и важнее
    // начала — отказы записи и озвучки приходят последними, — а целиком
    // отчёт всё равно уходит на шлюз кнопкой «Отчёт».
    this.lines = this.lines.concat([{ text: text + ": " + value }]).slice(-6)
  },

  // Повторное нажатие по идущей проверке означает «хватит»: отдельной
  // кнопки для этого на круглом экране нет места.
  run() {
    var self = this
    if (self.busy) {
      self.cancelRun()
      return
    }
    self.busy = true
    self.cancelled = false
    self.showCancel = true
    self.runClass = "run-busy"
    self.runLabel = "Остановить"
    self.progressText = "готовлю проверку"
    self.lines = []
    self.hasReport = false

    var report = {
      startedAt: new Date().toISOString(),
      build: CONFIG_STAMP,
      versionCode: VERSION_CODE,
      modules: [
        probe("record", record, ["start", "stop"]),
        probe("request", request, ["upload", "download", "onDownloadComplete"]),
        probe("uploadtask", uploadtask, ["uploadFile"]),
        probe("prompt", prompt, ["show", "showDialog", "showToast"]),
        probe("audio", audio, ["play", "pause", "stop"]),
        probe("file", file, ["readArrayBuffer", "move", "delete", "writeArrayBuffer"]),
        probe("volume", volume, ["getMediaValue", "setMediaValue"])
      ],
      steps: []
    }
    report.recordFrameEventProperty = recordingCapability().frameEventAvailable

    self.add("сборка часов", String(VERSION_CODE))
    report.modules.forEach(function(entry) {
      self.add(entry.module, (entry.present.join(",") || "нет методов") + (entry.missing.length ? " | нет: " + entry.missing.join(",") : ""))
    })

    loadSettings(function(settings) {
      report.gatewayUrl = settings.gatewayUrl || ""
      report.hasToken = !!settings.deviceToken
      self.add("адрес", report.gatewayUrl || "не задан")
      self.add("токен", report.hasToken ? "задан" : "НЕ ЗАДАН")

      networkType(function(type) {
        report.network = type || "неизвестно"
        self.add("сеть", report.network)
        self.checkGateway(report)
      })
    })
  },

  cancelRun() {
    if (!this.busy) return
    this.cancelled = true
    this.showCancel = false
    this.busy = false
    this.runClass = "run-button"
    this.runLabel = "Проверить ещё раз"
    this.progressText = "проверка остановлена"
  },

  // Проверяем два адреса по очереди: открытый /health и защищённый
  // /api/v1/status. Так видно, что именно не сходится — сеть, адрес или
  // токен. Раньше все три случая выглядели одинаково.
  checkGateway(report) {
    var self = this
    if (self.cancelled) return
    self.progressText = "проверяю шлюз"
    var base = getCached().gatewayUrl || ""
    if (!base) {
      self.finish(report)
      return
    }

    self.timedRequest(base + "/health", null, function(health) {
      if (self.cancelled) return
      report.steps.push(health)
      self.add("/health", health.status + " за " + health.ms + " мс" + (health.error ? " — " + health.error : ""))

      var token = getCached().deviceToken
      self.timedRequest(base + "/api/v1/status", token, function(status) {
        if (self.cancelled) return
        report.steps.push(status)
        self.add("/status", status.status + " за " + status.ms + " мс" + (status.error ? " — " + status.error : ""))
        if (status.body) {
          report.gatewayBuild = status.body.buildId
          report.mode = status.body.mode
          self.add("режим шлюза", String(status.body.mode))
          self.add("озвучка", status.body.capabilities && status.body.capabilities.speech ? "есть" : "нет")
          self.add("сборка шлюза", String(status.body.buildId || "").slice(0, 12))
        }
        self.probeTls(report, 0)
      })
    })
  },

  // Проба доверия к сертификатам.
  //
  // Часы вернули код 35 — это отказ TLS-соединения, а не ответ сервера.
  // Наш адрес на deno.net отдаёт четырёхуровневую цепочку с двумя
  // перекрёстно подписанными корнями (Root YE ← X2 ← X1), и встроенные
  // TLS-стеки на таких часто спотыкаются. Проверяем несколько адресов с
  // разными удостоверяющими центрами: те, что пройдут, покажут, за каким
  // именно сертификатом можно спрятать шлюз.
  probeTls(report, index) {
    var self = this
    if (self.cancelled) return
    var targets = [
      { name: "Google", url: "https://www.google.com/generate_204" },
      { name: "Cloudflare", url: "https://cloudflare.com/cdn-cgi/trace" },
      { name: "Telegram", url: "https://api.telegram.org" },
      { name: "LetsEncrypt", url: "https://letsencrypt.org/robots.txt" },
      { name: "без шифрования", url: "http://neverssl.com" }
    ]
    if (index >= targets.length) {
      report.tls = self.tlsResults
      self.probeSpeech(report, function() {
        self.probeFrameDelivery(report, function() { self.probeRecording(report) })
      })
      return
    }
    if (index === 0) self.tlsResults = []
    var target = targets[index]
    self.progressText = "сертификат " + (index + 1) + " из " + targets.length
    self.timedRequest(target.url, null, function(result) {
      if (self.cancelled) return
      self.tlsResults.push({ name: target.name, status: result.status, ms: result.ms, error: result.error })
      self.add(target.name, (result.status ? "код " + result.status : "не дошёл") + (result.error ? " — " + result.error : ""))
      self.probeTls(report, index + 1)
    })
  },

  // Короткая пробная запись: какой формат на самом деле выдаёт рантайм.
  // Расширение файла врёт — из-за этого шлюз отправлял провайдеру
  // application/octet-stream, и запись отклонялась.
  // Тишина при озвучке и сломанная озвучка выглядят одинаково. Громкость и
  // состояние последнего воспроизведения различают их за один взгляд.
  probeSpeech(report, next) {
    var self = this
    if (self.cancelled) return
    self.progressText = "проверяю звук"
    // Прошлый вариант только пересказывал последнее воспроизведение, а его
    // могло не быть вовсе — в отчёте это выглядело как «ничего не известно».
    // Теперь звук проверяется по-настоящему: шлюз синтезирует свою короткую
    // фразу, часы её скачивают и проигрывают.
    speakTest(function(result) {
      if (self.cancelled) return
      report.mediaVolume = result.volume
      report.speechTest = { ok: true, downloadedMs: result.downloadedMs, totalMs: result.ms, started: result.started,
        transport: lastSpeechReport().transport, headerShape: lastSpeechReport().headerShape,
        phase: lastSpeechReport().phase, code: lastSpeechReport().code,
        attempts: lastSpeechReport().attempts, fallback: lastSpeechReport().fallback,
        timings: lastSpeechReport().timings, bits: lastSpeechReport().bits,
        decoder: lastSpeechReport().decoder }
      report.playback = lastPlaybackReport()
      self.add("громкость", self.volumeText(result.volume))
      var speechTimings = lastSpeechReport().timings
      self.add("звук", "проиграно за " + result.ms + " мс: запрос " + speechTimings.fetchMs +
        ", разбор " + speechTimings.decodeMs + ", запись " + speechTimings.writeMs + " мс")
      next()
    }, function(error) {
      if (self.cancelled) return
      report.mediaVolume = error.volume
      report.speechTest = {
        ok: false, message: error.message, code: error.code || null,
        downloadedMs: error.downloadedMs || null, totalMs: error.ms || null,
        transport: lastSpeechReport().transport, headerShape: lastSpeechReport().headerShape,
        phase: lastSpeechReport().phase, runtimeCode: lastSpeechReport().code,
        attempts: lastSpeechReport().attempts, fallback: lastSpeechReport().fallback,
        timings: lastSpeechReport().timings, bits: lastSpeechReport().bits,
        decoder: lastSpeechReport().decoder
      }
      report.playback = lastPlaybackReport()
      self.add("громкость", self.volumeText(error.volume))
      self.add("звук", "не удалось: " + error.message)
      next()
    })
  },

  volumeText(value) {
    if (value === undefined || value === null || value < 0) return "модуль недоступен"
    if (value < 0.05) return "в нуле — озвучку не слышно"
    return Math.round(value * 100) + "%"
  },

  // Приходят ли кадры PCM — единственный вопрос, от которого зависит, может
  // ли вопрос отправляться сам, когда человек замолчал. Проверяется отдельно
  // от записи: там кадры могут не понадобиться вовсе, и отказ спутался бы с
  // отказом записи.
  //
  // Стоит он и вторым делом: зонд идёт сразу после озвучки, то есть ровно в
  // том порядке, в котором на часах ломался микрофон. Если кадры приходят
  // здесь — аудиосессия отпускается как надо.
  probeFrameDelivery(report, next) {
    var self = this
    if (self.cancelled) return
    self.progressText = "проверяю автоотправку"
    self.add("кадры", "слушаю 2,5 с…")
    probeFrames(function(result) {
      if (self.cancelled) return
      report.frameProbe = result
      var verdict = result.frames > 0
        ? result.frames + " кадров, " + result.bytes + " байт — автоотправка возможна"
        : (result.error || "кадров нет") + (result.code ? " (код " + result.code + ")" : "")
      self.add("кадры", verdict)
      // Если кадры не пришли из-за 202, следующий вопрос — а стартует ли
      // запись вообще хоть в какой-нибудь форме.
      self.progressText = "перебираю формы записи"
      probeRecordShapes(function(shapes) {
        if (self.cancelled) return
        report.recordShapes = shapes
        var working = shapes.filter(function(entry) { return entry.started })
        self.add("формы записи", working.length
          ? "стартует: " + working.map(function(e) { return e.name }).join(", ")
          : "ни одна не стартует (" + shapes.map(function(e) { return e.name + ":" + (e.code || "?") }).join(" ") + ")")
        next()
      })
    })
  },

  probeRecording(report) {
    var self = this
    if (self.cancelled) return
    self.progressText = "проверяю запись"
    self.add("запись", "пробую…")
    var recordStartedAt = Date.now()
    recordAudio(function(audio) {
      report.recordMs = Date.now() - recordStartedAt
      report.recordedMs = audio.recordedMs || null
      if (self.cancelled) return
      if (audio.bytes) {
        var framed = new Uint8Array(audio.bytes)
        var framedHead = ""
        for (var fi = 0; fi < 8 && fi < framed.length; fi++) {
          var fh = framed[fi].toString(16)
          framedHead += (fh.length < 2 ? "0" + fh : fh)
        }
        report.recordType = audio.contentType
        report.recordSize = framed.length
        report.recordHead = framedHead
        report.capture = audio.capture || recordingCapability().last
        self.add("запись", framed.length + " байт, тип " + audio.contentType + ", автостоп " + (report.capture.stoppedBySilence ? "по паузе" : "по завершению"))
        self.finish(report)
        return
      }
      report.recordUri = audio.uri
      report.recordType = audio.contentType
      file.readArrayBuffer({
        uri: audio.uri,
        success: function(data) {
          if (self.cancelled) return
          var bytes = data && (data.buffer || data)
          var size = bytes ? (bytes.byteLength || bytes.length || 0) : 0
          var head = ""
          try {
            var view = new Uint8Array(bytes)
            for (var i = 0; i < 8 && i < view.length; i++) {
              var h = view[i].toString(16)
              head += (h.length < 2 ? "0" + h : h)
            }
          } catch (error) { head = "не прочитать" }
          report.recordSize = size
          report.recordHead = head
          report.capture = recordingCapability().last
          self.add("запись", size + " байт, тип " + audio.contentType + ", байты " + head)
          self.finish(report)
        },
        fail: function() {
          report.recordError = { message: "файл записи не прочитался", uri: audio.uri, code: null }
          self.add("запись", "файл не прочитался: " + audio.uri)
          self.finish(report)
        }
      })
    }, function(error) {
      report.capture = recordingCapability().last
      // Без этого в отчёте оставалась только пустота на месте записи: причина
      // жила лишь строкой на экране и до шлюза не доезжала.
      report.recordError = {
        message: (error && error.message) || "ошибка",
        code: (error && error.code) || null
      }
      self.add("запись", "не удалась: " + report.recordError.message)
      self.finish(report)
    })
  },

  timedRequest(url, token, done) {
    var started = Date.now()
    var finished = false
    var settle = function(result) {
      if (finished) return
      finished = true
      result.ms = Date.now() - started
      result.url = url
      done(result)
    }
    var timer = setTimeout(function() { settle({ status: 0, error: "нет ответа за 10 с" }) }, 10000)
    var stop = function(result) { clearTimeout(timer); settle(result) }

    try {
      fetch.fetch({
        url: url,
        method: "GET",
        header: token ? { "X-TimeW-Device-Token": token } : {},
        success: function(response) {
          var code = response && (response.code || response.statusCode) || 0
          var body = null
          try {
            var raw = response && (response.data || response.body)
            body = typeof raw === "string" ? JSON.parse(raw) : raw
          } catch (error) { body = null }
          stop({ status: code, body: body })
        },
        fail: function(error, code) {
          stop({ status: code || 0, error: (error && error.message) || "ошибка запроса" })
        }
      })
    } catch (error) {
      stop({ status: 0, error: "вызов fetch не удался" })
    }
  },

  finish(report) {
    if (this.cancelled) return
    // Этапы последнего голосового запроса: часы знают общее время, шлюз —
    // сколько из него ушло на провайдера. Без этой пары «долго думает»
    // неотличимо от «медленный канал».
    var voice = lastVoiceStats()
    if (voice.at) {
      report.lastVoice = voice
      this.add("последний запрос", voice.totalMs + " мс всего" +
        (voice.timings ? ", провайдер " + voice.timings.providerMs + " мс, шлюз " + voice.timings.totalMs + " мс" : "") +
        (voice.error ? ", ошибка: " + voice.error : ""))
    }
    this.busy = false
    this.showCancel = false
    this.runClass = "run-button"
    this.runLabel = "Проверить ещё раз"
    this.progressText = "проверка завершена"
    this.report = report
    this.hasReport = true
  },

  // Отчёт уходит на шлюз и попадает в его лог: это единственный способ
  // увидеть состояние часов, не пересылая скриншоты.
  send() {
    var self = this
    // Строка состояния одна на всё: отдельная строка под результат
    // отправки выталкивала отчёт за нижний край круга.
    if (!self.report) {
      self.progressText = "сначала «Проверить всё»"
      return
    }
    self.progressText = "отправляю отчёт…"
    sendDiagnostics(self.report, function(response) {
      self.progressText = "отчёт отправлен" + (response && response.buildId ? " (шлюз " + String(response.buildId).slice(0, 8) + ")" : "")
    }, function(error) {
      self.progressText = "не отправился: " + ((error && error.message) || "ошибка")
    })
  }
}
</script>

<style>
/* Раскладка по кругу: верхний ряд там, где круг даёт 265px, кнопка и
   отчёт — в середине, где помещаются 370. Страница всегда 480: при
   меньшей ширине рантайм прижимает содержимое влево, и левый край уходит
   под рамку. */
.page { width: 480px; height: 480px; flex-direction: column; align-items: center; justify-content: center; background-color: #0b1020; }

.top-row { flex-direction: row; justify-content: center; align-items: center; height: 68px; }
.top-button { width: 126px; height: 68px; border-radius: 22px; background-color: #22314e; justify-content: center; align-items: center; margin-left: 4px; margin-right: 4px; }
.send-button { background-color: #2c3e5c; }
.top-label { color: #cfe0f7; font-size: 18px; font-weight: bold; text-align: center; }

.run-button { width: 370px; height: 96px; border-radius: 34px; background-color: #31b2d8; justify-content: center; align-items: center; margin-top: 4px; flex: none; }
.run-busy { width: 370px; height: 96px; border-radius: 34px; background-color: #9fb3cc; justify-content: center; align-items: center; margin-top: 4px; flex: none; }
.run-label { color: #07111e; font-size: 25px; font-weight: bold; }

.progress { color: #7de3ff; font-size: 16px; height: 24px; margin-top: 4px; text-align: center; width: 370px; lines: 1; text-overflow: ellipsis; }

.diag-scroll { width: 370px; height: 180px; margin-top: 4px; flex: none; flex-direction: column; }
.line { width: 370px; flex-direction: column; margin-top: 4px; padding-left: 12px; padding-right: 12px; }
.line-text { color: #eaf1ff; font-size: 16px; lines: 2; text-overflow: ellipsis; width: 346px; }
</style>
