<template>
  <div class="page">
    <!-- Обе цели наверху — кнопки, а не подписи: по тексту высотой в шрифт
         пальцем не попасть. Правая кнопка листает список, когда заметок
         больше, чем помещается, и обновляет его, когда все на экране. -->
    <div class="top-row">
      <div class="top-button" onclick="goBack"><text class="top-label">Назад</text></div>
      <div class="top-button refresh-button" onclick="pageOrRefresh"><text class="top-label">{{pageLabel}}</text></div>
    </div>

    <!-- Большая кнопка и здесь: диктовка — главное действие экрана,
         а список нужен реже, чем кажется. -->
    <div class="{{dictateClass}}" onclick="dictate">
      <text class="dictate-label">{{dictateLabel}}</text>
    </div>

    <!-- Одна строка состояния вместо четырёх: каждая отдельная строка
         двигала бы список под рамку. -->
    <text class="error" if="{{errorText}}">{{errorText}}</text>
    <text class="hint" if="{{hintText}}">{{hintText}}</text>

    <!-- Ни list, ни list-item: в этой сборке Vela они не рисуются вовсе
         (проверено в эмуляторе на экране ответа). Работает scroll с
         обычными div, в том числе с for. Показываем ровно две заметки:
         scroll в этой сборке не обрезает содержимое, и третья залезала бы
         под рамку, а прокрутку проверить нечем. -->
    <scroll class="notes-scroll" scroll-y="true">
      <div class="note-item" for="{{visibleNotes}}" onclick="openNote($item.id)">
        <div class="note-copy">
          <text class="note-text">{{ $item.text }}</text>
          <text class="note-date">{{ $item.createdAt }}</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import prompt from "@system.prompt"
import vibrator from "@system.vibrator"
import router from "@system.router"
import { listNotes, deleteNote, voiceUri, voiceBytes, query } from "../../common/api"
import { recordAudio, stopRecording, cancelRecording } from "../../common/audio"
import { getQueued, enqueueAudio, loadQueue } from "../../common/queue"
import { getCachedNotes, saveCachedNotes, loadCachedNotes } from "../../common/notes-cache"
import { loadSettings, getCached } from "../../common/settings"

function messageFrom(error) {
  return error && error.message ? error.message : "Не удалось связаться со шлюзом"
}

function texts(notes) {
  return (notes || []).map(function(note) {
    var createdAt = note.createdAt || ""
    if (createdAt.length >= 16) createdAt = createdAt.slice(0, 16).replace("T", " ")
    return { id: note.id, text: note.text, createdAt: createdAt }
  })
}

export default {
  // Параметр маршрута: главный экран открывает заметки сразу «в диктовку».
  protected: {
    autoDictate: ""
  },

  private: {
    notes: [],
    // На экран помещаются две заметки; остальные листаются кнопкой.
    visibleNotes: [],
    notesPage: 0,
    pageLabel: "Обновить",
    hasNotes: false,
    emptyNotes: false,
    stale: false,
    hintText: "",
    errorText: "",
    queuedCount: 0,
    busy: false,
    dictateClass: "dictate-button",
    dictateLabel: "Надиктовать",
    voiceEpoch: 0,
    recording: false,
    settingsReady: false,
    lastRefreshAt: 0
  },

  onShow() {
    var self = this
    loadSettings(function() {
      self.settingsReady = true
      loadCachedNotes(function(cached) {
        if (cached) self.show(cached, true)
        loadQueue(function() {
          self.queuedCount = getQueued().length
          self.updateHint()
          if (!getCached().gatewayUrl || !getCached().deviceToken) {
            self.errorText = "Сначала настройте шлюз"
            return
          }
          // Кнопка «Заметка» на главном экране означает «хочу продиктовать
          // заметку», а не «покажи список». Раньше она просто открывала экран,
          // и надиктовать можно было только вторым нажатием — здесь.
          if (self.autoDictate && !self.busy) {
            self.autoDictate = ""
            self.dictate()
          }
          var now = Date.now()
          if (self.lastRefreshAt && now - self.lastRefreshAt < 30000) return
          self.lastRefreshAt = now
          self.refresh()
        })
      })
    })
  },

  show(notes, stale) {
    this.notes = texts(notes)
    this.hasNotes = this.notes.length > 0
    this.emptyNotes = this.notes.length === 0 && !stale
    this.stale = stale && this.notes.length > 0
    this.notesPage = 0
    this.applyPage()
  },

  // Страница списка и подпись правой кнопки считаются вместе: кнопка либо
  // листает, либо обновляет, и подпись обязана это показывать.
  applyPage() {
    var size = 2
    var total = this.notes.length
    var pages = Math.max(1, Math.ceil(total / size))
    if (this.notesPage >= pages) this.notesPage = 0
    this.visibleNotes = this.notes.slice(this.notesPage * size, this.notesPage * size + size)
    this.pageLabel = pages > 1 ? "Ещё · " + (this.notesPage + 1) + "/" + pages : "Обновить"
    this.updateHint()
  },

  pageOrRefresh() {
    if (this.notes.length > 2) {
      this.notesPage += 1
      this.applyPage()
      return
    }
    this.refresh()
  },

  // Одна строка на все состояния списка: что не отправлено, что показано
  // из кэша, что список пуст, что по заметке можно нажать. Отдельными
  // строками они выталкивали список за край круга.
  updateHint() {
    if (this.queuedCount) {
      this.hintText = "не отправлено: " + this.queuedCount
      return
    }
    if (this.stale) {
      this.hintText = "список с прошлого раза"
      return
    }
    if (this.emptyNotes) {
      this.hintText = "Заметок пока нет"
      return
    }
    this.hintText = this.hasNotes ? "нажмите на заметку, чтобы прочитать" : ""
  },

  refresh() {
    var self = this
    listNotes(function(response) {
      self.show(response.notes, false)
      self.errorText = ""
      saveCachedNotes(response.notes)
    }, function(error) {
      // Показанный из кэша список лучше пустого экрана: заметки никуда не
      // делись, человек их уже видел.
      var cached = getCachedNotes()
      if (cached && cached.length > 0) {
        self.show(cached, true)
      } else {
        self.errorText = messageFrom(error)
      }
    })
  },

  setBusy(value) {
    this.busy = value
    this.dictateClass = value ? "dictate-busy" : "dictate-button"
  },

  goBack() {
    router.back()
  },

  openNote(id) {
    var self = this
    var note = null
    for (var i = 0; i < self.notes.length; i++) {
      if (self.notes[i].id === id) { note = self.notes[i]; break }
    }
    if (!note) return
    prompt.showDialog({
      title: note.createdAt ? String(note.createdAt).slice(0, 16).replace("T", " ") : "Заметка",
      message: note.text,
      buttons: [{ text: "Закрыть" }, { text: "Удалить" }],
      success: function(data) {
        if (data && data.index === 1) self.askDelete(id)
      }
    })
  },

  dictate() {
    var self = this
    if (!self.settingsReady || !getCached().gatewayUrl || !getCached().deviceToken) {
      self.errorText = "Сначала настройте шлюз"
      return
    }
    // Идёт запись — значит нажатие означает «я договорил»: заканчиваем и
    // отправляем, а не отменяем.
    if (self.recording) {
      self.recording = false
      self.dictateLabel = "Думаю"
      stopRecording()
      return
    }
    if (self.busy) {
      // Аварийный размыкатель на случай, если рантайм молчит.
      self.voiceEpoch += 1
      cancelRecording()
      self.setBusy(false)
      self.dictateLabel = "Надиктовать"
      return
    }
    var epoch = self.voiceEpoch + 1
    self.voiceEpoch = epoch
    self.recording = true
    self.setBusy(true)
    self.errorText = ""
    self.dictateLabel = "Готово"

    recordAudio(function(audio) {
      if (epoch !== self.voiceEpoch) return
      self.recording = false
      self.dictateLabel = "Думаю"
      var send = audio.bytes ? voiceBytes : voiceUri
      var source = audio.bytes || audio.uri
      send(source, audio.contentType, "note", function(response) {
        if (epoch !== self.voiceEpoch) return
        self.setBusy(false)
        self.dictateLabel = "Надиктовать"
        self.confirmDraft(response.transcript || "")
      }, function(error) {
        if (epoch !== self.voiceEpoch) return
        self.setBusy(false)
        self.dictateLabel = "Надиктовать"
        // Без сети распознать некому: откладываем саму запись, а не текст.
        if (!(error && error.serverError)) {
          self.defer(audio, error)
          return
        }
        self.errorText = messageFrom(error)
      }, { recordedMs: audio.recordedMs })
    }, function(error) {
      if (epoch !== self.voiceEpoch) return
      self.recording = false
      self.setBusy(false)
      self.dictateLabel = "Надиктовать"
      self.errorText = messageFrom(error)
    })
  },

  defer(audio, error) {
    var self = this
    enqueueAudio(audio.uri, audio.contentType, function() {
      self.queuedCount = getQueued().length
      self.updateHint()
      self.errorText = "Нет связи — отправлю, когда появится сеть"
    }, function(queueError) {
      // Отложить не удалось — значит запись потеряна, и причина именно в
      // часах, а не в сети. Показываем ошибку очереди, иначе человек чинил бы
      // связь вместо места на устройстве.
      self.errorText = messageFrom(queueError || error)
    }, error && error.requestKey, audio.bytes)
  },

  // Распознанное показываем до сохранения: неверно расслышанная заметка
  // хуже отсутствующей, потому что ей верят.
  confirmDraft(text) {
    var self = this
    if (!text) {
      self.errorText = "Ничего не расслышал"
      return
    }
    prompt.showDialog({
      title: "Сохранить заметку?",
      message: text,
      buttons: [{ text: "Сохранить" }, { text: "Отмена" }],
      success: function(data) {
        if (!data || data.index !== 0) return
        self.save(text)
      }
    })
  },

  save(text) {
    var self = this
    self.setBusy(true)
    var key = "timew-note-" + Date.now() + "-" + text.length
    // Заметка уже подтверждена человеком, поэтому уходит обычным текстовым
    // запросом — распознавать второй раз нечего.
    var done = function() {
      self.setBusy(false)
      vibrator.vibrate({ mode: "short" })
      self.refresh()
    }
    query("Запиши: " + text, done, function(error) {
      self.setBusy(false)
      self.errorText = messageFrom(error)
    }, key)
  },

  askDelete(id) {
    var self = this
    if (self.busy || !id) return
    var noteText = ""
    for (var i = 0; i < self.notes.length; i++) {
      if (self.notes[i].id === id) { noteText = self.notes[i].text; break }
    }
    prompt.showDialog({
      title: "Удалить заметку?",
      message: noteText,
      buttons: [{ text: "Удалить" }, { text: "Отмена" }],
      success: function(data) {
        if (data && data.index === 0) self.performDelete(id)
      }
    })
  },

  performDelete(id) {
    var self = this
    self.setBusy(true)
    deleteNote(id, function() {
      self.setBusy(false)
      vibrator.vibrate({ mode: "short" })
      self.refresh()
    }, function(error) {
      self.setBusy(false)
      self.errorText = messageFrom(error)
    })
  }
}
</script>

<style>
/* Раскладка по кругу: верхний ряд стоит там, где круг даёт 265px, а
   диктовка и список — в середине, где помещаются все 370. Страница всегда
   480: при меньшей ширине рантайм прижимает содержимое влево. */
.page { width: 480px; height: 480px; flex-direction: column; align-items: center; justify-content: center; background-color: #0b1020; }
.top-row { flex-direction: row; justify-content: center; align-items: center; height: 68px; }
.top-button { width: 126px; height: 68px; border-radius: 22px; background-color: #22314e; justify-content: center; align-items: center; margin-left: 4px; margin-right: 4px; }
.refresh-button { background-color: #2c3e5c; }
.top-label { color: #cfe0f7; font-size: 18px; font-weight: bold; text-align: center; }

.dictate-button { width: 370px; height: 100px; border-radius: 34px; background-color: #31b2d8; justify-content: center; align-items: center; margin-top: 4px; }
.dictate-busy { width: 370px; height: 100px; border-radius: 34px; background-color: #6f8aa6; justify-content: center; align-items: center; margin-top: 4px; }
.dictate-label { color: #07111e; font-size: 26px; font-weight: bold; }

.hint { color: #6f80a2; font-size: 15px; height: 24px; margin-top: 4px; text-align: center; width: 340px; lines: 1; text-overflow: ellipsis; }
.error { color: #ff8f8f; font-size: 15px; height: 24px; margin-top: 4px; text-align: center; width: 340px; lines: 1; text-overflow: ellipsis; }

.notes-scroll { width: 370px; height: 160px; margin-top: 4px; flex: none; flex-direction: column; }
.note-item { width: 366px; height: 72px; margin-top: 6px; padding-left: 16px; padding-right: 16px; border-radius: 18px; background-color: #141d33; align-items: center; }
.note-copy { flex-direction: column; width: 330px; }
.note-text { color: #eaf1ff; font-size: 19px; lines: 1; text-overflow: ellipsis; width: 330px; }
.note-date { color: #7084a7; font-size: 13px; lines: 1; text-overflow: ellipsis; width: 330px; margin-top: 2px; }
</style>
