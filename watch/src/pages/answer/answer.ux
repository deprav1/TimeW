<template>
  <div class="page">
    <div class="topbar">
      <text class="brand">{{headline}}</text>
    </div>
    <!-- Ни list, ни list-item: в этой сборке Vela они не рисуются ни сами
         по себе, ни внутри scroll — экран ответа оставался пустым в
         эмуляторе. Работает связка scroll + обычные div.
         Текст режется на страницы, а не прокручивается: прокрутку проверить
         нечем (ввод в эмуляторе до рантайма не доходит), а scroll в этой
         сборке не обрезает содержимое — длинный ответ залезал на кнопку.
         Тап по карточке листает дальше, по кругу. -->
    <scroll class="answer-scroll" scroll-y="true">
      <div class="answer-item" onclick="nextPage">
        <text class="answer-text">{{answerText}}</text>
      </div>
    </scroll>
    <!-- Обе кнопки в один ряд: по отдельности они не помещались в полосу,
         где круглый экран ещё широкий, и нижняя уходила под рамку. -->
    <div class="action-row">
      <div class="action-button" if="{{canSpeak}}" onclick="repeat"><text class="action-label">{{speakLabel}}</text></div>
      <!-- Удаление стоит рядом с текстом, который удаляют: из списка
           человек подтверждал бы вслепую, видя только первую строку. -->
      <div class="delete-button" if="{{canDelete}}" onclick="askDelete"><text class="delete-label">Удалить</text></div>
      <div class="back-button" onclick="goBack"><text class="back-label">Назад</text></div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import { speak, stopSpeaking } from "../../common/speech"
import { deleteNote } from "../../common/api"

function labelForSource(source) {
  if (source === "ai") return "ОТВЕТ ИИ"
  if (source === "note") return "ЗАМЕТКА"
  if (source === "home") return "КОМАНДА"
  if (!source) return "ОТВЕТ"
  return String(source).toUpperCase()
}

// Сколько символов помещается в карточку: 28px в 330px ширины дают около
// 20 символов в строке, строк влезает шесть. Замерено по скриншоту: при 130
// шестая строка обрывалась многоточием, то есть часть текста была не
// прочитана и не пролистана. Режем по словам, чтобы фраза не рвалась.
var PAGE_LIMIT = 105

function paginate(text) {
  var rest = String(text || "")
  var pages = []
  while (rest.length > PAGE_LIMIT) {
    var cut = rest.lastIndexOf(" ", PAGE_LIMIT)
    if (cut < PAGE_LIMIT * 0.6) cut = PAGE_LIMIT
    pages.push(rest.substring(0, cut))
    rest = rest.substring(cut)
    while (rest.charAt(0) === " ") rest = rest.substring(1)
  }
  pages.push(rest)
  return pages
}

export default {
  protected: {
    text: "",
    source: "",
    speechId: "",
    // Приходит, когда экран открыт из списка заметок: тогда здесь же можно
    // и удалить прочитанное.
    noteId: ""
  },

  private: {
    sourceLabel: "ОТВЕТ",
    headline: "ОТВЕТ",
    answerText: "",
    pages: [],
    pageIndex: 0,
    speaking: false,
    canSpeak: false,
    canDelete: false,
    speakLabel: "Слушать"
  },

  onInit() {
    this.sourceLabel = labelForSource(this.source)
    this.pages = paginate(this.text || "Пустой ответ")
    this.showPage(0)
    this.canSpeak = !!this.speechId
    this.canDelete = !!this.noteId
  },

  // Заголовок несёт и номер страницы: отдельной строки под него нет, а без
  // счётчика непонятно, что текст продолжается.
  showPage(index) {
    this.pageIndex = index
    this.answerText = this.pages[index] || ""
    this.headline = this.pages.length > 1
      ? this.sourceLabel + " · " + (index + 1) + " из " + this.pages.length + " · тап"
      : this.sourceLabel
  },

  nextPage() {
    if (this.pages.length < 2) return
    this.showPage((this.pageIndex + 1) % this.pages.length)
  },

  goBack() {
    router.back()
  },

  // Удаление необратимо, а список после возврата перечитывается сам —
  // поэтому подтверждение обязательно, а возврат идёт сразу за удалением.
  askDelete() {
    var self = this
    if (!self.noteId) return
    prompt.showDialog({
      title: "Удалить заметку?",
      message: self.text,
      buttons: [{ text: "Удалить" }, { text: "Отмена" }],
      success: function(data) {
        if (!data || data.index !== 0) return
        self.headline = "удаляю…"
        deleteNote(self.noteId, function() {
          router.back()
        }, function(error) {
          self.headline = (error && error.message) || "не удалилось"
        })
      }
    })
  },

  repeat() {
    var self = this
    if (!self.speechId) return
    if (self.speaking) {
      stopSpeaking()
      self.speaking = false
      self.speakLabel = "Слушать"
      return
    }
    self.speaking = true
    self.speakLabel = "Стоп"
    speak(self.speechId, function() {
      self.speaking = false
      self.speakLabel = "Слушать"
    }, function() {
      self.speaking = false
      self.speakLabel = "Слушать"
    })
  }
}
</script>

<style>
/* Экран целиком под чтение. Круг на y≈90 даёт 374px, на y≈350 — 426px,
   поэтому карточка текста 370px занимает всю доступную ширину, а кнопки
   внизу сужены до 288: на y=430 круг оставляет 293. Страница всегда 480:
   при меньшей ширине рантайм прижимает содержимое влево, и левый край
   уходит под рамку. */
.page { width: 480px; height: 480px; flex-direction: column; align-items: center; justify-content: center; background-color: #0b1020; }
.topbar { flex-direction: row; justify-content: center; align-items: center; height: 36px; width: 300px; }
.brand { color: #7de3ff; font-size: 17px; font-weight: bold; width: 300px; lines: 1; text-overflow: ellipsis; text-align: center; }
.answer-scroll { width: 370px; height: 260px; margin-top: 4px; flex: none; flex-direction: column; }
/* Карточка — она же кнопка «дальше», поэтому высота фиксирована: иначе
   короткая страница давала бы маленькую цель. */
.answer-item { width: 366px; height: 256px; flex-direction: column; padding: 18px; border-radius: 20px; background-color: #141d33; }
.answer-text { color: #eaf1ff; font-size: 28px; line-height: 36px; lines: 6; text-overflow: ellipsis; width: 330px; }
.action-row { flex-direction: row; justify-content: center; align-items: center; margin-top: 4px; height: 76px; }
.action-button { width: 140px; height: 76px; border-radius: 24px; background-color: #9fb3cc; justify-content: center; align-items: center; margin-right: 8px; }
.action-label { color: #07111e; font-size: 19px; font-weight: bold; }
/* Кнопок в ряду максимум две: «Слушать» бывает только у ответа, «Удалить» —
   только у заметки, и вместе они не встречаются. */
.delete-button { width: 140px; height: 76px; border-radius: 24px; background-color: #d98a91; justify-content: center; align-items: center; margin-right: 8px; }
.delete-label { color: #07111e; font-size: 19px; font-weight: bold; }
.back-button { width: 140px; height: 76px; border-radius: 24px; background-color: #31b2d8; justify-content: center; align-items: center; }
.back-label { color: #07111e; font-size: 19px; font-weight: bold; }
</style>
