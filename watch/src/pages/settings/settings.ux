<template>
  <div class="page">
    <div class="topbar">
      <text class="brand">НАСТРОЙКИ</text>
      <text class="back" onclick="goBack">назад</text>
    </div>

    <!-- Четыре карточки в столбик не помещаются в 480px, а прокрутить их
         нельзя: статический <list-item> в этой сборке Vela не рендерится
         (проверено в эмуляторе). Поэтому компактные строки: вся строка —
         кнопка, значение справа. -->
    <!-- Адрес и токен нельзя ввести на часах: в рантайме Vela нет ни
         prompt.show, ни элемента input (проверено опросом рантайма).
         Поэтому они приходят из сборки (npm run setup),
         а здесь только показываются — чтобы видеть, куда стучится приложение. -->
    <!-- Тип сети решает вопрос архитектуры: если при выключенном Wi-Fi тут
         «через телефон» и «Проверить связь» проходит, часам достаточно
         телефона в кармане и шлюза в сети. -->
    <div class="row" onclick="refreshNetwork">
      <text class="row-label">Сеть</text>
      <text class="row-value">{{networkDisplay}}</text>
    </div>

    <div class="row" onclick="toggleSpeak">
      <text class="row-label">Озвучка</text>
      <text class="row-value">{{speakDisplay}}</text>
    </div>

    <div class="row" onclick="cycleProvider">
      <text class="row-label">Модель</text>
      <text class="row-value">{{providerDisplay}}</text>
    </div>

    <text class="check-result" if="{{checkResult}}">{{checkResult}}</text>
    <text class="error-text" if="{{errorText}}">{{errorText}}</text>

    <div class="row diag-row" onclick="openDiag">
      <text class="row-label">Диагностика</text>
      <text class="row-value">проверить всё →</text>
    </div>

    <text class="note-line">Сборка {{versionCode}} · параметры сохраняются сразу</text>

    <div class="action-row">
      <div class="small-button" onclick="checkConnection"><text class="small-label">Проверить связь</text></div>
      <div class="small-button save-button" onclick="goBack"><text class="small-label">Готово</text></div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import fetch from "@system.fetch"
import { loadSettings, saveSettings, applyRemoteRuntime } from "../../common/settings"
import { networkType } from "../../common/net"
import { VERSION_CODE } from "../../common/build-info"

function labelForNetwork(type) {
  if (!type) return "не определена"
  if (type === "none") return "нет сети"
  if (type === "wifi") return "Wi-Fi"
  if (type === "bluetooth") return "через телефон"
  return type
}

function messageFrom(error) {
  return error && error.message ? error.message : "Не удалось связаться со шлюзом"
}

function normalizeUrl(url) {
  if (!url) return url
  if (url.length > 0 && url.charAt(url.length - 1) === "/") {
    return url.substring(0, url.length - 1)
  }
  return url
}

function labelForSpeak(enabled) {
  return enabled ? "включено" : "выключено"
}

function labelForProvider(provider) {
  if (provider === "gemini") return "Gemini"
  if (provider === "openai") return "ChatGPT"
  return "авто (как на шлюзе)"
}

function isValidUrl(url) {
  if (!url) return false
  return url.indexOf("http://") === 0 || url.indexOf("https://") === 0
}

function statusFrom(response) {
  if (!response) return 0
  if (typeof response.code === "number") return response.code
  if (typeof response.statusCode === "number") return response.statusCode
  return 0
}

function connectionError(status, parsed) {
  if (status === 401) return "Неверный токен устройства"
  if (status === 404) return "Шлюз найден, но путь /health недоступен"
  if (status >= 400) return "Шлюз вернул ошибку " + status
  if (parsed && parsed.ok === false) {
    return parsed.error && parsed.error.message ? parsed.error.message : "Шлюз вернул ошибку"
  }
  return "Не удалось проверить шлюз"
}

export default {
  private: {
    gatewayUrl: "",
    deviceToken: "",
    tokenDisplay: "",
    speakAnswers: false,
    speakDisplay: "выключено",
    aiProvider: "auto",
    providerDisplay: "авто (как на шлюзе)",
    checkResult: "",
    errorText: "",
    networkDisplay: "…",
    // Каким путём шла последняя проверка связи — попадает в её результат.
    checkVia: "",
    // Номер сборки: единственный способ понять, что именно стоит на часах.
    versionCode: VERSION_CODE
  },

  onInit() {
    var self = this
    self.refreshNetwork()
    loadSettings(function(settings) {
      self.gatewayUrl = settings.gatewayUrl || ""
      self.deviceToken = settings.deviceToken || ""
      self.tokenDisplay = self.deviceToken ? "••••" + self.deviceToken.slice(-4) : "(не задан)"
      self.speakAnswers = !!settings.speakAnswers
      self.speakDisplay = labelForSpeak(self.speakAnswers)
      self.aiProvider = settings.aiProvider || "auto"
      self.providerDisplay = labelForProvider(self.aiProvider)
    })
  },

  refreshNetwork() {
    var self = this
    self.networkDisplay = "…"
    networkType(function(type) {
      self.networkDisplay = labelForNetwork(type)
    })
  },

  toggleSpeak() {
    this.speakAnswers = !this.speakAnswers
    this.speakDisplay = labelForSpeak(this.speakAnswers)
    this.persist()
  },

  cycleProvider() {
    var order = ["auto", "gemini", "openai"]
    var index = order.indexOf(this.aiProvider)
    this.aiProvider = order[(index + 1) % order.length]
    this.providerDisplay = labelForProvider(this.aiProvider)
    this.persist()
  },

  // Проверка отвечает на три вопроса сразу, потому что по отдельности они
  // бесполезны: есть ли у часов сеть и какая, доходим ли до шлюза, принят ли
  // токен. Раньше любая из трёх причин выглядела одинаково — «не удалось
  // связаться», — и человек шёл чинить не то.
  //
  // Тип сети здесь особенно важен: если он оказывается «через телефон» и
  // проверка проходит, значит часам не нужен Wi-Fi, и шлюзу место в интернете,
  // а не в домашней сети (docs/architecture.md).
  checkConnection() {
    var self = this
    if (!isValidUrl(self.gatewayUrl)) {
      self.errorText = "Адрес должен начинаться с http:// или https://"
      self.checkResult = ""
      return
    }
    self.errorText = ""
    self.checkResult = "проверяю…"
    networkType(function(type) {
      self.networkDisplay = labelForNetwork(type)
      self.checkVia = labelForNetwork(type)
      if (type === "none") {
        self.checkResult = ""
        self.errorText = "На часах нет сети. Включите Wi-Fi или держите телефон рядом"
        return
      }
      self.checkGateway()
    })
  },

  checkGateway() {
    var self = this
    var finished = false
    var timer = setTimeout(function() {
      if (finished) return
      finished = true
      self.checkResult = ""
      self.errorText = "Шлюз не ответил вовремя"
    }, 20000)
    var settle = function(handler) {
      return function() {
        if (finished) return
        finished = true
        clearTimeout(timer)
        handler.apply(null, arguments)
      }
    }
    try { fetch.fetch({
      url: normalizeUrl(self.gatewayUrl) + "/api/v1/status",
      method: "GET",
      header: self.deviceToken ? { "X-TimeW-Device-Token": self.deviceToken } : {},
      success: settle(function(response) {
        var raw = response && (response.data || response.body || response)
        var parsed = raw
        try {
          parsed = typeof raw === "string" ? JSON.parse(raw) : raw
        } catch (error) {
          parsed = null
        }
        var status = statusFrom(response)
        if ((status && status >= 400) || (parsed && parsed.ok === false) || !parsed) {
          self.checkResult = ""
          self.errorText = connectionError(status, parsed)
          return
        }
        var mode = parsed && parsed.mode ? parsed.mode : "unknown"
        if (parsed && parsed.runtime) applyRemoteRuntime(parsed.runtime)
        // Главная строка проверки: видно, каким путём часы дошли до шлюза.
        self.checkResult = "связь есть (" + self.checkVia + "), режим " + mode
        // Озвучка требует отдельного ключа на шлюзе. Без этой строки
        // включённая «Озвучка» просто молчит, и понять почему нельзя.
        var caps = parsed && parsed.capabilities
        if (caps && caps.speech === false) {
          self.errorText = "Озвучка не настроена на шлюзе"
        }
      }),
      fail: settle(function(error) {
        self.checkResult = ""
        var status = statusFrom(error)
        if (status === 401) {
          self.errorText = "Неверный токен устройства"
          return
        }
        // Сеть на часах есть, а шлюз не отвечает. Для пути через телефон это
        // почти всегда означает домашний адрес шлюза: снаружи он не виден.
        self.errorText = self.checkVia === "через телефон"
          ? "Сеть через телефон есть, но шлюз недоступен — нужен адрес, видимый из интернета"
          : messageFrom(error)
      })
    }) } catch (error) {
      settle(function() { self.checkResult = ""; self.errorText = messageFrom(error) })()
    }
  },

  persist() {
    var self = this
    if (!isValidUrl(self.gatewayUrl)) {
      self.errorText = "Адрес должен начинаться с http:// или https://"
      return
    }
    self.errorText = ""
    saveSettings({
      gatewayUrl: self.gatewayUrl,
      deviceToken: self.deviceToken,
      speakAnswers: self.speakAnswers,
      aiProvider: self.aiProvider
    }, function() {
      self.checkResult = "сохранено"
    }, function(error) {
      self.errorText = messageFrom(error)
    })
  },

  // Диагностика вынесена отдельным экраном: она длинная, а нужна редко.
  openDiag() {
    router.push({ uri: "/pages/diag" })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
/* Отступы по бокам крупные: на круглом экране у верхней и нижней строки
   круг сужается примерно до 250px, и при 22px первую строку срезало —
   видно на фотографии с устройства. */
.page { flex-direction: column; background-color: #0b1020; padding-left: 38px; padding-right: 38px; padding-top: 18px; padding-bottom: 14px; }
/* Круглый экран: у верхнего края круг узкий, поэтому панель собрана
   к центру, а не растянута — иначе заголовок срезало бы углом. */
.topbar { flex-direction: row; justify-content: center; align-items: center; height: 26px; }
.brand { color: #7de3ff; font-size: 17px; font-weight: bold; }
.back { color: #70d7ef; font-size: 16px; margin-left: 12px; padding-left: 6px; padding-right: 6px; }
.row { flex-direction: row; align-items: center; justify-content: space-between; height: 38px; margin-top: 5px; padding-left: 12px; padding-right: 12px; border-radius: 12px; background-color: #141d33; }
.row-label { color: #8fa7ca; font-size: 15px; }
.row-value { color: #eaf1ff; font-size: 15px; margin-left: 10px; flex: 1; lines: 1; text-overflow: ellipsis; text-align: right; }
.check-result { color: #7de3ff; font-size: 15px; margin-top: 10px; lines: 2; text-overflow: ellipsis; text-align: center; width: 100%; }
.note-line { color: #5d6c8c; font-size: 13px; margin-top: 6px; lines: 1; text-overflow: ellipsis; text-align: center; width: 100%; }
.error-text { color: #ff8f8f; font-size: 14px; margin-top: 6px; lines: 3; text-overflow: ellipsis; text-align: center; width: 100%; }
.action-row { flex-direction: row; margin-top: 10px; justify-content: center; }
.small-button { width: 130px; height: 40px; margin-left: 5px; margin-right: 5px; border-radius: 13px; background-color: #2b9ec2; justify-content: center; align-items: center; }
.save-button { background-color: #2b9ec2; }
.small-label { color: #07111e; font-size: 16px; font-weight: bold; }
.diag-row { background-color: #1d3550; }
</style>
