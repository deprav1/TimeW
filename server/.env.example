HOST=127.0.0.1
PORT=8787
DEVICE_TOKEN=
DATA_DIR=./data
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=whisper-1
GEMINI_MODEL=gemini-3.6-flash
MAX_AUDIO_BYTES=1048576
AI_TIMEOUT_MS=20000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
LOG_REQUESTS=1
# Необязательный commit/revision id для /health и /api/v1/status.
TIMEW_BUILD_ID=

# --- Tuya Cloud (OpenAPI) — прямое управление устройствами, без Android-компаньона ---
# Access ID/Key проекта в Tuya IoT Platform (Cloud Development).
TUYA_ACCESS_ID=
# Access Secret проекта в Tuya IoT Platform.
TUYA_ACCESS_SECRET=
# UID пользователя в приложении Smart Life/Tuya Smart — нужен только для
# GET /api/v1/home/devices (список устройств для заполнения data/devices.json).
TUYA_UID=
# Базовый URL региона Tuya. По умолчанию — Европа.
TUYA_BASE_URL=https://openapi.tuyaeu.com
# Таймаут запросов к Tuya, мс.
TUYA_TIMEOUT_MS=10000

# --- Диалоговая память (для уточняющих вопросов вроде «а подробнее?») ---
# Сколько последних пар «вопрос-ответ» подмешивать в контекст запроса к AI.
DIALOG_TURNS=6
# Через сколько мс реплика считается устаревшей и не подмешивается (15 минут).
DIALOG_TTL_MS=900000

# --- Озвучка ответа (TTS) ---
# Оставьте пустым: при AI_PROVIDER=gemini шлюз использует тот же AI_API_KEY,
# при AI_PROVIDER=openai — тот же OpenAI-совместимый endpoint.
# Явное `none` полностью отключает озвучку.
TTS_PROVIDER=
# Для отдельного OpenAI-совместимого синтеза задайте provider и ключ.
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
# Модель синтеза речи.
TTS_MODEL=gpt-4o-mini-tts
# Голос синтеза речи.
TTS_VOICE=alloy
# Gemini speech model/voice (используются при TTS_PROVIDER=gemini).
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
# Сколько мс живёт speechId, выданный в ответах /api/v1/voice и
# /api/v1/query — по нему часы скачивают аудио через GET /api/v1/speak/:id.
# По истечении этого времени идентификатор перестаёт работать (404).
SPEECH_TTL_MS=300000
